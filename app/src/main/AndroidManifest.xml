<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pos.scanner">

    <!-- الإنترنت للاتصال بالخادم · الكاميرا لماسح الباركود داخل النظام · الاهتزاز -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 🆕 v1.12 — البحث الصوتي داخل الموقع (الميكروفون) وتسجيل الدخول بالبصمة -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- الكاميرا مستحبّة لا إجبارية: النظام يعمل حتى بلا كاميرا -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- 🆕 v1.12 — الميكروفون والبصمة مستحبّان لا إجباريّان: التطبيق يعمل حتى بلا أيٍّ منهما -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="نظام الأوائل المحاسبى"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- 📤 v1.6 — FileProvider: بابُ مشاركةِ الملفّات.
             أندرويد يمنعُ تمريرَ مسارِ ملفٍّ خامٍّ (file://) إلى تطبيقٍ آخر منذ
             أندرويد ٧ — يرمي FileUriExposedException. فالملفُّ يُمرَّرُ عبر
             مزوّدٍ يمنحُ التطبيقَ المستقبِلَ إذناً مؤقّتاً لقراءتِه وحدَه. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
