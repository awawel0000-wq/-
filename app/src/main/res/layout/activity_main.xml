<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- معاينة الكاميرا المباشرة ملء الشاشة -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- إطار توجيه لمسح الباركود في المنتصف -->
    <View
        android:id="@+id/scanBox"
        android:layout_width="280dp"
        android:layout_height="180dp"
        android:layout_centerInParent="true"
        android:background="@drawable/scanner_box_border" />

    <!-- ★ العمودُ العلويُّ فوقَ الإطارِ الأخضر: الدخول ← لوحةُ النتيجة ← عدّادُ المسحات -->
    <LinearLayout
        android:id="@+id/headerStack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/scanBox"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- زرُّ الدخول إلى نظام الأوائل (jawwal) — أعلى العمود -->
        <Button
            android:id="@+id/btnSite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:maxWidth="320dp"
            android:background="#1C6FBF"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="🏠 الدخول إلى نظام الأوائل المحاسبي"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp" />

        <!-- لوحةُ النتيجةِ — تعرضُ ردَّ الخادمِ وتبقى ظاهرةً (اسمُ الصنفِ والسعرُ بعدَ النجاح) -->
        <TextView
            android:id="@+id/txtResultTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="340dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="وجّه الكاميرا نحو الباركود…"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:elevation="6dp" />

        <!-- عدّادُ مسحاتِ الجلسة — أسفلَ اللوحة -->
        <TextView
            android:id="@+id/txtScanCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="المسحات: 0"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:elevation="6dp" />
    </LinearLayout>

    <!-- ★ زرُّ القائمة (☰) — يجمعُ كلَّ الأوامر مثلَ تطبيقاتِ الجوال -->
    <Button
        android:id="@+id/btnMenu"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="14dp"
        android:background="#99000000"
        android:text="☰"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:contentDescription="القائمة" />

    <!-- الأزرارُ القديمةُ صارتْ أوامرَ داخلَ القائمة (☰) — نُبقيها مخفيّةً كوظائفَ يناديها الكود -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:background="#99000000"
        android:padding="10dp"
        android:src="@android:drawable/ic_menu_preferences"
        android:contentDescription="Settings"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnTorch"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_below="@id/btnSettings"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:background="#99000000"
        android:padding="10dp"
        android:src="@android:drawable/ic_menu_day"
        android:contentDescription="Torch"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnRefresh"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_below="@id/btnTorch"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:background="#99000000"
        android:padding="10dp"
        android:src="@android:drawable/ic_popup_sync"
        android:contentDescription="تحديث الحالة"
        android:visibility="gone" />

    <!-- ═══ شاشةُ الإعداداتِ المعتمةُ الكاملة (تُغطّي الخلفيّةَ تماماً) ═══ -->
    <ScrollView
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- شريطُ العنوانِ + زرُّ الإغلاق -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:id="@+id/lblSettingsTitle"
                    android:text="⚙️ الإعدادات"
                    android:textColor="#38BDF8"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCloseSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="#334155"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="✕ إغلاق"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </RelativeLayout>

            <!-- ═══ قسمُ الربطِ: الاتصالُ اليدويُّ + مسحُ QR ═══ -->
            <LinearLayout
                android:id="@+id/secConn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblConn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="الاتصال اليدوي بالخادم"
                    android:textColor="#38BDF8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtServerIp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#0B1220"
                    android:hint="عنوان IP الكمبيوتر (مثال: 192.168.1.100)"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8" />

                <EditText
                    android:id="@+id/edtServerPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#0B1220"
                    android:hint="البورت (افتراضي: 5005)"
                    android:inputType="number"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8" />

                <Button
                    android:id="@+id/btnTestConnection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#334155"
                    android:text="فحص الاتصال"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/txtTestResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#38BDF8"
                    android:textAlignment="center"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#0284C7"
                    android:text="حفظ الإعدادات"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="#334155" />

                <TextView
                    android:id="@+id/lblRelinkHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="أو غيّر الجهاز بمسح رمز الربط (QR) من الكمبيوتر"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textAlignment="center" />

                <Button
                    android:id="@+id/btnScanLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#168568"
                    android:text="📷 مسح رمز الربط بالكاميرا"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ═══ قسمُ اللغةِ والصوت: 4 اختيارات مستقلّة + تفعيل + تحميل ═══ -->
            <LinearLayout
                android:id="@+id/secLang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/lblVoiceSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="الصوت"
                    android:textColor="#38BDF8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/switchVoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🔊 تفعيل النطق الصوتي بالنتيجة"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lblVoiceLang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="لغة الصوت:"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rgVoiceLang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbVoiceAr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عربي"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:paddingEnd="24dp" />

                    <RadioButton
                        android:id="@+id/rbVoiceEn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="English"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp" />
                </RadioGroup>

                <Button
                    android:id="@+id/btnInstallVoice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#B45309"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="⬇ تحميل صوت TTS"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtVoiceHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="عند النجاح يقول اسم الصنف، وعند الفشل «لم يصل إلى النظام»."
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="#334155" />

                <TextView
                    android:id="@+id/lblUiLang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="لغة البرنامج:"
                    android:textColor="#38BDF8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgUiLang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbUiAr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عربي"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:paddingEnd="24dp" />

                    <RadioButton
                        android:id="@+id/rbUiEn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="English"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp" />
                </RadioGroup>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- شريط المسحات المعلقة (مُلغى — مخفي) -->
    <LinearLayout
        android:id="@+id/layoutPendingQueue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomBar"
        android:background="#CC7F1D1D"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtPendingCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FCA5A5"
            android:textSize="12sp"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- بطاقة الحالة والنتيجة في الأسفل (تبقى ظاهرةً: الاسم + السعر) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#CC0F172A"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/txtStatusBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="جاهز للمسح"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:padding="6dp" />

        <TextView
            android:id="@+id/txtItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="وجه الكاميرا نحو أي باركود..."
            android:textColor="#F8FAFC"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/txtItemDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textAlignment="center" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <View
                android:id="@+id/dotConnectionStatus"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/txtConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ الموقع (jawwal) داخل التطبيق ═══ -->
    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</RelativeLayout>
