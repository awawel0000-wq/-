<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d1117">

    <!-- النظام (jawwal / الماسح) داخل WebView ملء الشاشة -->
    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- شاشة الربط: تظهر أوّل مرّة أو عند الحاجة لتغيير العنوان -->
    <ScrollView
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0d1117"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="26dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:text="نظام الأوائل"
                android:textColor="#e8f4ff"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="اربط الجوّال بالكمبيوتر للبدء"
                android:textColor="#8899aa"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:text="عنوان الكمبيوتر (IP)"
                android:textColor="#9fb0c3"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtIp"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="#161f2b"
                android:hint="192.168.1.100"
                android:inputType="number|numberDecimal"
                android:digits="0123456789."
                android:padding="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#5a6b82"
                android:textAlignment="center"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="البورت"
                android:textColor="#9fb0c3"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtPort"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="#161f2b"
                android:hint="5005"
                android:inputType="number"
                android:padding="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#5a6b82"
                android:textAlignment="center"
                android:textSize="17sp" />

            <Button
                android:id="@+id/btnOpen"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="26dp"
                android:background="#168568"
                android:text="اتّصال وفتح النظام"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="تأكّد أن الجوّال والكمبيوتر على نفس شبكة الواي‑فاي"
                android:textColor="#8899aa"
                android:textSize="12sp"
                android:textAlignment="center" />
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
